<script type="x/template" id="vue-bank-data-select">
    <div>
        <div class="cmp cmp-address-list">

            <div v-show="userBankData.length == 0">
                <div>
                    <div>
                    	<div class="card rounded-sm mb-0 p-1-rem text-small">
					        <div>{{ trans("Ceres::Template.myAccountBankNoBankData") }}</div>
				        </div>
                    </div>
                </div>
            </div>

            <div class="dropdown items" v-show="userBankData.length > 0">
                <div id="bankData" class="rounded-sm p-1-rem text-small" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-flip="false">
                    <span class="item-inner p-0">
                        <span class="item-content" v-if="selectedBankData">
                            <span>Kontoinhaber: ${ selectedBankData.accountOwner }</span>
                            <span>Bank:        ${ selectedBankData.bankName }</span>
                            <span>IBAN:        ${ selectedBankData.iban }</span>
                            <span>BIC:         ${ selectedBankData.bic }</span>
                        </span>

                        <div class="item-content" v-show="!selectedBankData">
                            <p class="mb-0 text-small">{{ trans("Ceres::Template.myAccountPleaseSelect") }}</p>
                        </div>
                    </span>
                </div>
                <div class="dropdown-menu" aria-labelledby="bankData">
                    <fieldset>
                    <legend>
                        <span class="d-none">{{ trans("Ceres::Template.myAccountBankDetails") }}</span>
                    </legend>
                    <ul class="card rounded-sm shadow-lg ul-my-account">
                        <li class="item" v-for="(bankData, index) in userBankData">
                            <input type="radio" :id="bankData.id" name="bankData" :value="bankData" @change="changeSelecting(bankData)">
                            <label :for="bankData.id" class="item-inner d-block" {{ set_testing_attr("data-testing", "bank-data-set") }}>
                                <span class="item-content card rounded-sm bg-transparent mb-2 p-1-rem text-small">
                                    <span>Kontoinhaber: ${ bankData.accountOwner }</span>
                                    <span>Bank:        ${ bankData.bankName }</span>
                                    <span>IBAN:        ${ bankData.iban }</span>
                                    <span>BIC:         ${ bankData.bic }</span>
                                </span><!--
                                -->
                                <div class="item-controls d-block">
                                    <span class="item-edit ml-auto" @click.prevent="openUpdateBank(index, bankData)">
                                        <button aria-label="delete-item" class="btn btn-primary btn-block btn-appearance" @click.prevent="openUpdateBank(index, bankData)" {{ set_testing_attr("data-testing", "bank-data-delete-set") }}>
                                            <span>{{ trans("Ceres::Template.myAccountEdit") }}</span>
                                        </button>
                                    </span>
                                    <span class="item-remove" @click.prevent="openDeleteBank(index, bankData)">
                                        <button aria-label="delete-item" class="btn btn-danger btn-block mt-2" @click.prevent="openDeleteBank(index, bankData)" {{ set_testing_attr("data-testing", "bank-data-open-set") }}>
                                            <span>Löschen</span>
                                        </button>
                                    </span>
                                </div>
                            </label>
                        </li>
                    </ul>
                    </fieldset>
                </div>
            </div>
            <div>
                <button class="btn btn-primary btn-appearance btn-block mt-2" @click.prevent="openAddBank()" {{ set_testing_attr("data-testing", "add-bank-data") }}>
                    <span>{{ trans("Ceres::Template.myAccountBankAddDataTitle") }}</span>
                </button>
            </div>
        </div>

        <div ref="bankInfoModal">
            <div class="modal fade" tabindex="-1" role="dialog" aria-labelledby="modal-title" aria-modal="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form id="my-bankForm" method="post" @submit.prevent>
                            <fieldset>
                                 <legend>
                                    <span class="d-none">${headline}</span>
                                 </legend>
                                 <div class="modal-body pb-0">
	                            	<button type="button" data-dismiss="modal" aria-hidden="true" class="close">
	                            		<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns:xlink="http://www.w3.org/1999/xlink" class="injected-svg icon bg-dark">
	                            			<path d="M16.2426 6.34311L6.34309 16.2426C5.95257 16.6331 5.95257 17.2663 6.34309 17.6568C6.73362 18.0473 7.36678 18.0473 7.75731 17.6568L17.6568 7.75732C18.0473 7.36679 18.0473 6.73363 17.6568 6.34311C17.2663 5.95258 16.6331 5.95258 16.2426 6.34311Z" fill="#212529"></path>
	                            			<path d="M17.6568 16.2426L7.75734 6.34309C7.36681 5.95257 6.73365 5.95257 6.34313 6.34309C5.9526 6.73362 5.9526 7.36678 6.34313 7.75731L16.2426 17.6568C16.6331 18.0473 17.2663 18.0473 17.6568 17.6568C18.0474 17.2663 18.0474 16.6331 17.6568 16.2426Z" fill="#212529"></path>
	                            		</svg>
	                            	</button>
	                            	<div class="text-center mt-xl-4 mt-3 mx-xl-4 mx-3 mb-4">
	                            		<h6 class="h3 mb-1">${headline}</h6>
	                            		<span>Fügen Sie Ihre Bankdaten hinzu</span>
	                            	</div>
	                            </div>
                                 <div class="modal-body mb-xl-4 mb-3 mx-xl-4 mx-3 pt-0">
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="form-group accountOwner" data-validate="text">
                                                <input class="form-control" placeholder="Kontoinhaber*" :id="'account_owner' + _uid" type="text" name="kontoinhaber" v-model="updateBankData.accountOwner" data-autofocus data-testing="address-account-owner">
                                                <label :for="'account_owner' + _uid">{{ trans("Ceres::Template.myAccountHolder") }}*</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-group">
                                                <input class="form-control" placeholder="Kreditinstitut" :id="'bank_name' + _uid" type="text" name="kreditInstitut" v-model="updateBankData.bankName" {{ set_testing_attr("data-testing", "address-bank-name") }}>
                                                <label :for="'bank_name' + _uid">{{ trans("Ceres::Template.myAccountBank") }}</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-group iban" data-validate="regex">
                                                <input class="form-control" placeholder="IBAN*" :id="'address_iban' + _uid" type="text" name="iban" data-validate-ref="/[a-zA-Z]{2}[0-9]{2}[a-zA-Z0-9]{4}[0-9]{7}([a-zA-Z0-9]?){0,16}/" maxlength="32" v-model="updateBankData.iban" {{ set_testing_attr("data-testing", "address-iban") }}>
                                                <label :for="'address_iban' + _uid">IBAN*</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <div class="form-group no-bottom" data-validate="regex">
                                                <input class="form-control" placeholder="BIC*" :id="'address_bic' + _uid" type="text" name="bic" data-validate-ref="/([a-zA-Z]{4}[a-zA-Z]{2}[a-zA-Z0-9]{2}([a-zA-Z0-9]{3})?)/" v-model="updateBankData.bic" {{ set_testing_attr("data-testing", "address-bic") }}>
                                                <label :for="'address_bic' + _uid">BIC* - {{ trans("Ceres::Template.myAccountBankBicNotification") }}</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-primary btn-block" @click="validateInput()" :disabled="waiting" {{ set_testing_attr("data-testing", "address-bank-submit") }}>
                                                <span>{{ trans("Ceres::Template.myAccountSave") }}</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div ref="bankDeleteModal">
            <div class="modal fade" tabindex="-1" role="dialog" aria-labelledby="modal-title" aria-modal="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h4 id="modal-title" class="modal-title">{{ trans("Ceres::Template.myAccountBankDeleteTitle") }}</h4>
                            <button type="button" class="close" @click="closeDeleteModal" aria-label="{{ trans("Ceres::Template.closeIcon") }}">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>

                        <div class="modal-body">
                            <fieldset>
                                <legend>
                                    <span class="d-none">{{ trans("Ceres::Template.myAccountBankDeleteTitle") }}</span>
                                </legend>
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div>{{ trans("Ceres::Template.myAccountBankDeleteWarning") }}</div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-3 offset-sm-6">
                                        <button type="button" class="btn btn-primary btn-block" @click="closeDeleteModal">{{ trans("Ceres::Template.myAccountCancel") }}</button>
                                    </div>
                                    <div class="col-sm-3">
                                        <button type="button" class="btn btn-primary btn-block" @click="removeBankInfo" {{ set_testing_attr("data-testing", "bank-data-delete-confirm") }}>{{ trans("Ceres::Template.myAccountDelete") }}</button>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</script>