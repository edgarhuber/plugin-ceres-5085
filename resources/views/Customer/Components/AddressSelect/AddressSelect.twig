{{ component( "Ceres::Customer.Components.AddressSelect.CreateUpdateAddress") }}
{{ component( "Ceres::Customer.Components.AddressSelect.AddressHeader") }}


<script type="x/template" id="vue-address-select">
    <div>
        <div class="cmp cmp-address-list">
            <div>
                <div
                    class="card rounded-sm p-1-rem mb-2 pointer"
                    :id="'addressMultiSelect' + _uid"
                    v-bind:class="{'card': !isAddressListEmpty && !(addressType === '2' && addressList.length === 1), 'items items-empty': isAddressListEmpty && (addressType === '2' && addressList.length === 1), 'is-loading disabled': isBasketLoading || isCheckoutReadonly}"
                    @click="onDropdownClicked($event)"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                    data-boundary="window"
                    data-flip="false"
                    ref="dropdown">

                    <div :class="{'error': showError}">
                        <div v-if="selectedAddress && selectedAddress.id == -99">
                            <p class="mb-0 text-small" :class="paddingClasses" :style="paddingInlineStyles">{{ trans("Ceres::Template.addressSameAsInvoice") }}</p>
                        </div>
                        <div v-else class="item-content text-small">
                            <div v-if="!isAddressListEmpty && selectedAddress">
                                <address-header :address="selectedAddress" :class="paddingClasses" :style="paddingInlineStyles"></address-header>
                            </div>
                            <p v-if="!isAddressListEmpty && !selectedAddress">{{ trans("Ceres::Template.addressPleaseSelect") }}</p>
                            <p class="mb-0" v-if="isAddressListEmpty">{{ trans("Ceres::Template.addressNoAddress") }}</p>
                        </div>
                    </div>
                </div>

                <div>
                    <button
                        class="btn btn-primary btn-appearance btn-block d-block"
                        v-if="isAddAddressEnabled" @click.prevent="showAddModal()" :disabled="isBasketLoading || isCheckoutReadonly"
                        {{ set_testing_attr(":data-testing", "\"addressTypePrefix + 'address-select-add'\"") | raw }}
                    >
                        <span>{{ trans("Ceres::Template.addressAddAddress") }}</span>
                    </button>

                    <button
                    	@click="toggleDropdown($event)"
                        class="btn btn-primary btn-appearance btn-block mt-2 d-block"
                        v-if="shouldShowEditAddressButton" :disabled="isBasketLoading || isCheckoutReadonly"
                        {{ set_testing_attr(":data-testing", "\"addressTypePrefix + 'address-select-open'\"") | raw }}
                    >
                        <span>{{ trans("Ceres::Template.addressChange") }}</span>
                    </button>
                </div>

                <div
                    class="dropdown-menu"
                    :aria-labelledby="'addressMultiSelect' + _uid"
                    {{ set_testing_attr(":data-testing", "\"addressTypePrefix + 'address-select-dropdown'\"") | raw }}
                >
                    <ul v-if="!isAddressListEmpty && !(addressType === '2' && addressList.length === 1)" class="card rounded-sm shadow-lg ul-my-account">
                        <dynamic-scroller
                            class="virtual-scroller"
                            :items="addressList"
                            :min-item-size="115"
                            key-field="id">
                            <template v-slot="{ item, index, active }">
                                <DynamicScrollerItem
                                    :item="item"
                                    :active="active"
                                    :data-index="index"
                                    :watch-data="true"
                                >
                                    <li class="item item-custom-address" role="radiogroup" aria-label="{{ trans("Ceres::Template.checkoutShippingAddress") }}">
                                        <input
                                            type="radio"
                                            :name="'shippingAddress' + _uid"
                                            :id="'addressSelectItem' + _uid + item.id"
                                            :value="item.id"
                                            :checked="selectedAddress && selectedAddress.id === item.id"
                                            @change="onAddressChanged(item)">
                                        <label :for="'addressSelectItem' + _uid + item.id" class="item-inner">
                                        <div class="container-fluid px-0">
                                            <div class="row">
                                                <div v-if="item.id == -99" class="col-12">
                                                    <p class="mb-0 text-small">{{ trans("Ceres::Template.addressSameAsInvoice") }}</p>
                                                </div>
                                                <div v-else class="col-12">
                                                	<div class="card bg-transparent rounded-sm p-1-rem mb-2 text-small">
                                                   		<address-header :address="item" :class="paddingClasses" :style="paddingInlineStyles"></address-header>
                                                   	</div>
                                                </div>
                                                 <!---->
                                                <div class="col-12">
                                                    <div class="item-controls row mt-0" v-if="item.id != -99">
                                                        <span
                                                            v-if="$store.getters.isLoggedIn"
                                                            class="primaryAddress col-12"
                                                            :class="item.pivot.isPrimary !== 1 ? 'addressType' + addressType : 'd-none addressType' + addressType"
                                                            :ref="'Address_' + addressType + '_' + item.id"
                                                            >
                                                            <button
                                                                class="btn btn-block btn-primary btn-appearance mr-1"
                                                                @click="setPrimaryAddress(item, addressType, $event)"
                                                            >
                                                                <span>{{ trans("Ceres::Template.addressSetPrimary") }}</span>
                                                            </button>
                                                        </span>
                                                        <span class="item-edit col-12">
                                                            <button
                                                                class="btn btn-primary btn-block btn-appearance mr-1"
                                                                @click.prevent="showEditModal(item)"
                                                                {{ set_testing_attr(":data-testing", "\"addressTypePrefix + 'address-select-edit'\"") | raw }}
                                                            >
                                                                <span>{{ trans("Ceres::Template.addressEdit") }}</span>
                                                            </button>
                                                        </span>
                                                        <span class="item-remove col-12">
                                                            <button
                                                                class="btn btn-danger"
                                                                @click.prevent="showDeleteModal(item)"
                                                                {{ set_testing_attr(":data-testing", "\"addressTypePrefix + 'address-select-remove'\"") | raw }}
                                                            >
                                                            	<span>Löschen</span>
                                                            </button>
                                                        </span>
                                                    </div>
                                                </div>
                                                </div>
                                            </div>
                                        </label>
                                    </li>
                                </DynamicScrollerItem>
                                <div class="layer-1 my-account-bottom"></div>
                            </template>

                        </dynamic-scroller>

                    </ul>

                </div>
            </div>
        </div>

        <div ref="addressModal">
            <div class="modal fade" tabindex="-1" role="dialog" aria-labelledby="modal-title" aria-modal="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-body pb-0">
	                    	<button type="button" data-dismiss="modal" aria-hidden="true" class="close">
	                           	<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns:xlink="http://www.w3.org/1999/xlink" class="injected-svg icon bg-dark">
	                      			<path d="M16.2426 6.34311L6.34309 16.2426C5.95257 16.6331 5.95257 17.2663 6.34309 17.6568C6.73362 18.0473 7.36678 18.0473 7.75731 17.6568L17.6568 7.75732C18.0473 7.36679 18.0473 6.73363 17.6568 6.34311C17.2663 5.95258 16.6331 5.95258 16.2426 6.34311Z" fill="#212529"></path>
	                       			<path d="M17.6568 16.2426L7.75734 6.34309C7.36681 5.95257 6.73365 5.95257 6.34313 6.34309C5.9526 6.73362 5.9526 7.36678 6.34313 7.75731L16.2426 17.6568C16.6331 18.0473 17.2663 18.0473 17.6568 17.6568C18.0474 17.2663 18.0474 16.6331 17.6568 16.2426Z" fill="#212529"></path>
	                       		</svg>
	                       	</button>
	                       	<div class="text-center mt-xl-4 mt-3 mx-xl-4 mx-3 mb-4">
                           		<h6 class="h3 mb-1">${headline}</h6>
                           		<span>Fügen Sie Ihre Adresse hinzu</span>
	                       	</div>
	                    </div>

                        <div class="modal-body mb-xl-4 mb-3 mx-xl-4 mx-3 pt-0" role="group" aria-label="{{ trans("Ceres::Template.addressShippingAddressCreate") }}">
                            <create-update-address
                                template="#vue-create-update-address"
                                :address-data="addressToEdit"
                                :address-modal="addressModal"
                                :modal-type="modalType"
                                :address-type="addressType"
                                @input="setAddressToEditField($event)"
                                :optional-address-fields="optionalAddressFields"
                                :required-address-fields="requiredAddressFields"
                                :default-salutation="defaultSalutation">
                            </create-update-address>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div ref="deleteModal" {{ set_testing_attr(":data-testing", "\"addressTypePrefix + 'address-select-remove-modal'\"") | raw }}>
            <div class="modal fade" tabindex="-1" role="dialog" aria-labelledby="modal-title" aria-modal="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h4 id="modal-title" class="modal-title">${headline}</h4>
                            <button type="button" class="close" @click="closeDeleteModal" aria-label="{{ trans("Ceres::Template.closeIcon") }}">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>

                        <div role="group" aria-label="{{ trans("Ceres::Template.addressShippingAddressDelete") }}" class="modal-body" {{ set_testing_attr(":data-testing", "\"addressTypePrefix + 'address-select-remove-modal-body'\"") | raw }}>
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="modal-address">
                                        <strong v-if="addressToDelete.name1 && addressToDelete.name1.length > 0">${addressToDelete.name1}</strong>
                                        <strong v-if="!addressToDelete.name1 || addressToDelete.name1.length == 0">${addressToDelete | optionType(11)} ${addressToDelete.name2} ${addressToDelete.name3}</strong>
                                        <span v-else>${selectedAddress | optionType(11)} ${addressToDelete.name2} ${addressToDelete.name3}</span>
                                        <span>${addressToDelete.name4}</span>
                                        <span>${addressToDelete.address1} ${addressToDelete.address2}</span>
                                        <span>
                                            <template v-if="addressToDelete.address1 === 'PACKSTATION' || addressToDelete.address1 === 'POSTFILIALE'">
                                                {{ trans("Ceres::Template.addressPostNummer") }}
                                                ${addressToDelete | optionType(6)}
                                            </template>
                                            ${ addressToDelete.address3 }
                                        </span>
                                        <span>${addressToDelete.postalCode} ${addressToDelete.town}</span>
                                        <span>${getCountryName(addressToDelete.countryId)}</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer" {{ set_testing_attr(":data-testing", "\"addressTypePrefix + 'address-select-remove-modal-footer'\"") | raw }}>
                            <button
                                type="button"
                                class="btn btn-medium mr-2 btn-outline-primary"
                                @click="closeDeleteModal"
                                {{ set_testing_attr(":data-testing", "\"addressTypePrefix + 'address-select-remove-modal-cancel'\"") | raw }}>
                                <span>{{ trans("Ceres::Template.addressCancel") }}</span>
                                <i class="fa fa-times" aria-hidden="true"></i>
                            </button>
                            <button
                                type="button"
                                class="btn btn-danger btn-appearance btn-medium"
                                :disabled="deleteModalWaiting" @click="deleteAddress"
                                {{ set_testing_attr(":data-testing", "\"addressTypePrefix + 'address-select-remove-modal-remove'\"") | raw }}>
                                <span>{{ trans("Ceres::Template.addressDelete") }}</span>
                                <icon icon="trash" :loading="deleteModalWaiting"></icon>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {% if services.template.isCurrentTemplate('tpl.checkout') and trans("Ceres::Template.checkoutInvalidShippingCountryGeoblocking") is not empty %}
            <div class="cmp-method-list mb-4" v-if="addressType == '2' && isInvalidShippingCountry && !isShopBuilder">
                <div class="method-list-item has-error w-100">
                    <div class="label">
                        <div class="content" data-testing="message-invalid-shipping-country">
                            {{ trans("Ceres::Template.checkoutInvalidShippingCountryGeoblocking") }}
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</script>
